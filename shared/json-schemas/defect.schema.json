{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scamroad.dev/schemas/defect.schema.json",
  "title": "Defect",
  "description": "A canonical physical road defect. One physical pothole = one defect record, linked to many observations.",
  "type": "object",
  "required": ["defect_id", "class_code", "location", "status", "first_seen", "times_seen"],
  "properties": {
    "defect_id": {
      "type": "string",
      "format": "uuid"
    },
    "class_code": {
      "type": "string",
      "enum": ["POTHOLE", "CRACK_LONG", "CRACK_TRANS", "CRACK_ALLIGATOR", "WATERLOGGING", "MANHOLE_DAMAGED", "MARKING_FADED", "SPEEDBREAKER_DAMAGED", "EDGE_DAMAGE", "SURFACE_DETERIORATION", "SHOULDER_DETERIORATION", "RUTTING", "UNEVEN_SURFACE"]
    },
    "location": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "accuracy_m": { "type": ["number", "null"], "minimum": 0, "description": "GPS accuracy in metres" }
      }
    },
    "road_segment_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "UNDER_REPAIR", "REPAIRED", "MERGED", "FALSE_POSITIVE"],
      "description": "Current lifecycle status"
    },
    "first_seen": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "times_seen": {
      "type": "integer",
      "minimum": 1
    },
    "latest_severity": {
      "type": ["object", "null"],
      "description": "Most recent severity assessment",
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "level": { "type": "string", "enum": ["Minor", "Moderate", "Severe", "Critical"] },
        "source": { "type": "string", "enum": ["auto", "human"] },
        "assessed_at": { "type": "string", "format": "date-time" }
      }
    },
    "best_image_url": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
