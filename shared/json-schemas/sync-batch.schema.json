{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scamroad.dev/schemas/sync-batch.schema.json",
  "title": "SyncBatch",
  "description": "A batch of observations sent from an edge device to the backend during sync. Idempotent: replaying the same batch (same idempotency_key) results in no duplicate records.",
  "type": "object",
  "required": ["batch_id", "device_id", "idempotency_key", "observations", "sent_at"],
  "properties": {
    "batch_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique ID for this sync batch"
    },
    "device_id": {
      "type": "string",
      "format": "uuid"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Client-generated key for idempotent ingestion. Same key = same batch, no duplicates."
    },
    "device_clock_offset_ms": {
      "type": ["integer", "null"],
      "description": "Estimated offset between device clock and GPS/NTP time in milliseconds"
    },
    "model_version": {
      "type": "string",
      "description": "Model version used for all detections in this batch"
    },
    "observations": {
      "type": "array",
      "items": { "$ref": "observation.schema.json" },
      "minItems": 1,
      "maxItems": 1000,
      "description": "Defect observations in this batch"
    },
    "media_manifest": {
      "type": "array",
      "description": "List of media files included in or referenced by this batch",
      "items": {
        "type": "object",
        "required": ["media_id", "filename", "sha256", "mime_type", "size_bytes"],
        "properties": {
          "media_id": { "type": "string", "format": "uuid" },
          "filename": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "mime_type": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "observation_ids": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" }
          }
        }
      }
    },
    "inspection_metadata": {
      "type": ["object", "null"],
      "description": "Optional metadata about the inspection session",
      "properties": {
        "inspection_id": { "type": "string", "format": "uuid" },
        "start_time": { "type": "string", "format": "date-time" },
        "end_time": { "type": ["string", "null"], "format": "date-time" },
        "route_geojson": { "type": ["object", "null"], "description": "GeoJSON LineString of the route" },
        "total_frames_processed": { "type": "integer", "minimum": 0 },
        "total_detections": { "type": "integer", "minimum": 0 },
        "avg_fps": { "type": ["number", "null"], "minimum": 0 },
        "avg_inference_ms": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp when the batch was sent"
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Number of times this batch has been retried"
    }
  },
  "additionalProperties": false
}
