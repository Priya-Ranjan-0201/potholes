{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scamroad.dev/schemas/observation.schema.json",
  "title": "DefectObservation",
  "description": "An immutable sighting of a defect from a single device pass. Never overwritten.",
  "type": "object",
  "required": ["observation_id", "defect_id", "device_id", "location", "confidence", "observed_at"],
  "properties": {
    "observation_id": {
      "type": "string",
      "format": "uuid"
    },
    "defect_id": {
      "type": "string",
      "format": "uuid",
      "description": "The canonical defect this observation belongs to"
    },
    "device_id": {
      "type": "string",
      "format": "uuid"
    },
    "inspection_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "detection_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Link to the source detection"
    },
    "location": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "accuracy_m": { "type": ["number", "null"], "minimum": 0 },
        "speed_mps": { "type": ["number", "null"], "minimum": 0, "description": "Speed in m/s" },
        "heading_deg": { "type": ["number", "null"], "minimum": 0, "maximum": 360 },
        "altitude_m": { "type": ["number", "null"] }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "class_code": {
      "type": "string"
    },
    "measurement_summary": {
      "type": ["object", "null"],
      "description": "Median measurements from the track",
      "properties": {
        "relative_area": { "type": "number" },
        "bbox_width_px": { "type": "number" },
        "bbox_height_px": { "type": "number" },
        "unit": { "type": "string" },
        "calibrated": { "type": "boolean" }
      }
    },
    "best_frame_path": {
      "type": ["string", "null"],
      "description": "Path or URL to the best-quality frame for this observation"
    },
    "track_length_frames": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Number of frames the defect was tracked in this pass"
    },
    "quality_score": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 1.0
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
