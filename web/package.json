{
  "name": "scamroad-web",
  "private": true,
  "version": "0.1.0",
  "description": "ScamRoad — Road defect monitoring dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "seed:demo": "python ../scripts/seed_demo_data.py --reset",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "@tanstack/react-query": "5.59.0",
    "framer-motion": "^14.10.1",
    "i18next": "23.15.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.0.2",
    "react-router-dom": "6.26.2",
    "recharts": "2.13.0",
    "tailwindcss": "3.4.13"
  },
  "devDependencies": {
    "@playwright/test": "1.48.0",
    "@testing-library/react": "16.0.1",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "9.12.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "5.4.8",
    "vitest": "2.1.2"
  }
}
