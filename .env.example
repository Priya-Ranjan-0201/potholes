# =============================================================================
# ScamRoad Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# --- Database (PostgreSQL + PostGIS) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scamroad
POSTGRES_USER=scamroad
POSTGRES_PASSWORD=changeme_in_production
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# --- MinIO (S3-compatible object storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_MEDIA=scamroad-media
MINIO_BUCKET_MODELS=scamroad-models
MINIO_USE_SSL=false

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
API_VERSION=0.1.0
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Security ---
JWT_SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Celery ---
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# --- Edge Device ---
EDGE_DEVICE_ID=
EDGE_DEVICE_KEY=
EDGE_API_URL=http://localhost:8000/api/v1
EDGE_MODEL_PATH=models/yolov8n_pothole.onnx
EDGE_CONFIDENCE_THRESHOLD=0.25
EDGE_IOU_THRESHOLD=0.45
EDGE_TARGET_FPS=15
EDGE_GPS_ACCURACY_THRESHOLD=50.0
EDGE_OUTBOX_MAX_SIZE_MB=500
EDGE_SYNC_INTERVAL_SECONDS=30

# --- Web Frontend ---
VITE_API_URL=http://localhost:8000/api/v1
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Mobile ---
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Weather (Open-Meteo, no key needed for free tier) ---
WEATHER_PROVIDER=open-meteo
WEATHER_API_URL=https://api.open-meteo.com/v1

# --- Monitoring ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

# --- Email/Notifications (disabled by default) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@scamroad.local
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_PUSH_ENABLED=false
NOTIFICATION_SMS_ENABLED=false
